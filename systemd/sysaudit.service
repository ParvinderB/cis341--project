#start the sysaudit daemon automatically at boot.
#Install to /etc/systemd/system/sysaudit.service

[Unit]
Description=sysaudit -System Health Monitor and security Daemon
After=local-fs.target

[Service]
Type=simple
User=auditmanager
ExecStart=/opt/sysaudit/sysaudit.sh --daemon

[Install]
WantedBy=multi-user.target
